# Copiá este archivo a .env en la raíz del repositorio.
# No pongas secretos reales en el ejemplo ni en el chat.

HOST=0.0.0.0
PORT=8000
EARTH_ECHO_ENV=development
EARTH_ECHO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EARTH_ECHO_MAX_BODY_BYTES=1048576

# Vacío: la API busca Earth_Echo_Catalogo.json subiendo desde el código.
EARTH_ECHO_CATALOG_PATH=

# Cesium ion no hace falta para la prueba con Natural Earth II.
# No uses el prefijo VITE_: un token con ese prefijo quedaría dentro del navegador.
CESIUM_ION_TOKEN=

# Descarga de productos NASA Earthdata, incluida la humedad SMAP (D02).
# También podés usar un archivo .netrc local. No pegues estos valores en el chat.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_MAP_KEY=
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
EWDSAPI_URL=https://ewds.climate.copernicus.eu/api
EWDSAPI_KEY=
ADSAPI_URL=https://ads.atmosphere.copernicus.eu/api
ADSAPI_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Actualización con API o tarea Windows/refresh:watch; 0 desactiva al reiniciar.
EARTH_ECHO_REFRESH_ENABLED=1
EARTH_ECHO_REFRESH_JOB_TIMEOUT_SECONDS=180
EARTH_ECHO_HYDROATLAS_TIMEOUT_SECONDS=420
EARTH_ECHO_CAMS_TIMEOUT_SECONDS=420
EARTH_ECHO_MARINE_TIMEOUT_SECONDS=300
EARTH_ECHO_SMOC_GLOBAL_TIMEOUT_SECONDS=600
EARTH_ECHO_PRODUCT_STORE_MAX_BYTES=512000000
EARTH_ECHO_USGS_DAYS=7
EARTH_ECHO_USGS_MIN_MAGNITUDE=4.5
EARTH_ECHO_USGS_LIMIT=500

# Modelo opcional, solo en el servidor. Si quedan vacíos, el asistente responde con las herramientas.
# La URL no se acepta desde el navegador. Un ejemplo local sería http://127.0.0.1:11434/v1 y qwen2.5:1.5b.
EARTH_ECHO_LLM_BASE_URL=
EARTH_ECHO_LLM_MODEL=
EARTH_ECHO_LLM_API_KEY=
EARTH_ECHO_LLM_TIMEOUT_SECONDS=20
EARTH_ECHO_LLM_MAX_TOKENS=400
