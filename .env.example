# Copiá este archivo a .env en la raíz del repositorio.
# No pongas secretos reales en el ejemplo ni en el chat.

HOST=0.0.0.0
PORT=8000
EARTH_ECHO_ENV=development
EARTH_ECHO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EARTH_ECHO_MAX_BODY_BYTES=1048576

# Vacío: la API busca Earth_Echo_Catalogo.json subiendo desde el código.
EARTH_ECHO_CATALOG_PATH=

# Cesium ion no hace falta para la prueba con Natural Earth II.
# No uses el prefijo VITE_: un token con ese prefijo quedaría dentro del navegador.
CESIUM_ION_TOKEN=

# Descarga de productos NASA Earthdata, incluida la humedad SMAP (D02).
# También podés usar un archivo .netrc local. No pegues estos valores en el chat.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
