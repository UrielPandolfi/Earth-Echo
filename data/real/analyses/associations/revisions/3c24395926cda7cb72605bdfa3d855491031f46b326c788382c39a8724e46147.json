ún y dirección causal no identificados; sin validación predictiva.","RONI resta SST media tropical que incluye el Caribe: puede existir acoplamiento matemático y fuentes climáticas compartidas. La asociación no demuestra teleconexión causal independiente; RONI y ONI son índices distintos y no se mezclan."]},{"id":"amoc-sst","title":"AMOC y SST del Caribe","status":"evaluated","reason":null,"x_name":"Transporte AMOC RAPID","y_name":"SST trimestral Caribe","x_unit":"Sv","y_unit":"°C","x_scope":"Sección RAPID26,5N; transporte integrado, positivo norte","y_scope":"CoralTempv3.1,441celdas0,05°, bordes nativos-67.50000/16.50000/-66.45000/17.55000; no SST global o temperatura del aire","n_pairs":40,"missing_pairs":0,"raw_r":0.5719222320644041,"residual_r":0.18973352776258728,"slope_x_per_year":-0.16729636489143923,"slope_y_per_year":0.03525989898989895,"intervals":[{"block_quarters":4,"low":-0.1761748609990364,"high":0.5401972507704781,"valid_draws":1000,"draws":1000},{"block_quarters":8,"low":-0.21538249720252603,"high":0.532163134042446,"valid_draws":1000,"draws":1000}],"points":[{"year":2014,"quarter":1,"start":"2014-01-01T00:00:00Z","end":"2014-04-01T00:00:00Z","x":15.203823280042931,"y":26.69633333333333,"residual_x":-1.3790497501262369,"residual_y":0.02032287878787642},{"year":2014,"quarter":2,"start":"2014-04-01T00:00:00Z","end":"2014-07-01T00:00:00Z","x":15.546390449589452,"y":27.396966666666668,"residual_x":-0.7693000344511347,"residual_y":-0.060310454545451364},{"year":2014,"quarter":3,"start":"2014-07-01T00:00:00Z","end":"2014-10-01T00:00:00Z","x":16.94751008647072,"y":28.475966666666665,"residual_x":-1.6560920455873145,"residual_y":-0.28700045454545275},{"year":2014,"quarter":4,"start":"2014-10-01T00:00:00Z","end":"2015-01-01T00:00:00Z","x":18.640471276863774,"y":28.6414,"residual_x":-0.3586214621615156,"residual_y":0.0826528787878793},{"year":2015,"quarter":1,"start":"2015-01-01T00:00:00Z","end":"2015-04-01T00:00:00Z","x":17.446984667132444,"y":26.950366666666